# --- LLM providers (OpenAI-compatible) ---
NVIDIA_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_PRIMARY=nvidia
LLM_FALLBACKS=groq,gemini
# Model IDs: copy ONLY from `python -m scripts.smoke_providers` output
MODEL_PLANNER_NVIDIA=nvidia/nemotron-3-ultra-550b-a55b
MODEL_EXTRACT_NVIDIA=nvidia/nemotron-3.5-bolt-e4b
MODEL_PLANNER_GROQ=openai/gpt-oss-120b
MODEL_EXTRACT_GROQ=openai/gpt-oss-20b
MODEL_PLANNER_GEMINI=
MODEL_EXTRACT_GEMINI=
# --- Supabase ---
SUPABASE_URL=
# Public anon key: used only by the website, copy it into web/js/config.js
SUPABASE_ANON_KEY=
# Only for legacy projects that sign JWTs with HS256 (Project Settings > API > JWT secret); else leave empty
SUPABASE_JWT_SECRET=
# Postgres connection string (Supabase > Project Settings > Database > Connection string, session pooler)
DATABASE_URL=
# --- Misc ---
APP_USER_AGENT="TravelMateAI/0.1 (contact: <your email>)"
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
ADMIN_KEY=
# Optional: only used by scripts/draft_prices.py to find price sources for the team to verify
TAVILY_API_KEY=
# Optional: OpenStreetMap places via Geoapify when public Overpass is down (geoapify.com, free key)
GEOAPIFY_API_KEY=

# Day planner: robust (Benders MILP + weather Plan B, no LLM call) or llm (LLM groups place IDs into days)
PLANNER=robust
# true = no database: reference data from data/*.csv, in-memory cache, trips saved in the browser
STATELESS=false
